# Copie este fichero a .env y ajuste los valores. NUNCA suba el .env al repositorio.

# Clave de firma JWT. Minimo 32 caracteres. Generela con: openssl rand -base64 48
ERP_JWT_SIGNING_KEY=cambie-esto-por-una-clave-aleatoria-de-64-caracteres-minimo

# Credenciales del endpoint /api/token-demo (solo desarrollo).
ERP_USUARIO_DEMO=admin